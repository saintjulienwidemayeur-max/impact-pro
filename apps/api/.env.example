# Copy to .env and adjust. Never commit real secrets.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://impact:impact_dev@localhost:5432/impact_pro?schema=public
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
# Generate with: openssl rand -base64 48
COOKIE_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Customer uploads (logos). Local disk is used unless all S3_* values below are set.
UPLOAD_DIR=var/uploads
UPLOAD_MAX_BYTES=10485760
# Ready-to-print artwork (banners, flags, roll-ups…): PNG/JPEG/WEBP/PDF
UPLOAD_ARTWORK_MAX_BYTES=26214400
# Rendered mock-up previews (PNG/JPEG) uploaded by the storefront at checkout
UPLOAD_PREVIEW_MAX_BYTES=3145728
# S3-compatible storage — MinIO from infra/docker-compose.yml. Leave empty to use local disk.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
# Public endpoints rate limits (per IP per THROTTLE_TTL_MS)
ORDER_THROTTLE_LIMIT=10
UPLOAD_THROTTLE_LIMIT=20
PREVIEW_THROTTLE_LIMIT=60
# Customer accounts (sessions, Argon2id, throttling)
SESSION_TTL_DAYS=30
SESSION_ABSOLUTE_TTL_DAYS=90
REGISTER_THROTTLE_LIMIT=5
LOGIN_THROTTLE_LIMIT=10
LOGIN_LOCKOUT_THRESHOLD=5
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
# Reverse proxies in front of the API (Render = 1) so per-IP limits see the client IP
TRUST_PROXY_HOPS=1
# Back-office (staff) sessions: shorter than customer sessions
STAFF_SESSION_IDLE_HOURS=8
STAFF_SESSION_ABSOLUTE_HOURS=24
# First administrator, created at API start ONLY when no staff account exists yet (SUPER_ADMIN, must change password at first login).
# Set the password through your secret manager / hosting dashboard, then remove both variables. Never commit real values.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# Dev/test only: password for the demo staff accounts created by `pnpm prisma:seed` (ignored in production)
DEV_STAFF_PASSWORD=

# Billing: public origin of this API (links in e-mailed documents) and public document link throttle
# PUBLIC_API_URL=https://impact-pro-api.onrender.com
# PUBLIC_DOC_THROTTLE_LIMIT=30
