// Impact Pro — Prisma schema v1 (Phase 1 foundation)
// See CLAUDE.md §6 for database rules.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Identity & tenancy ─────────────────────────────

enum Role {
  PLATFORM_ADMIN // Impact Pro staff with full access
  STAFF // Impact Pro operations staff
  ORG_OWNER
  ORG_ADMIN
  ORG_MEMBER
  ORG_VIEWER
}

enum StaffRole {
  SUPER_ADMIN
  ADMIN
  SALES
  ACCOUNTING
  PRODUCTION
  SUPPORT
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

/// Impact Pro employee role (back-office RBAC). Customers have `staffRole = null`.
enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

model Organization {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  status      OrganizationStatus @default(ACTIVE)
  taxId       String?
  phone       String?
  email       String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  memberships Membership[]
  auditLogs   AuditLog[]

  @@index([status])
}

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  passwordHash       String? // Argon2id; null for invited users without password yet
  firstName          String?
  lastName           String?
  /// Display name entered at sign-up (customer accounts); firstName/lastName stay for staff/org users.
  fullName           String?
  phone              String?
  status             UserStatus         @default(ACTIVE)
  isStaff            Boolean            @default(false)
  /// Back-office role; set only when `isStaff` is true.
  staffRole          StaffRole?
  /// Staff accounts created by an admin start with a temporary password that must be changed at first login.
  mustChangePassword Boolean            @default(false)
  emailVerified      DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  memberships        Membership[]
  sessions           Session[]
  auditLogs          AuditLog[]
  customOrders       CustomOrder[]
  customer           Customer?
  orderEvents        CustomOrderEvent[]
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           Role         @default(ORG_MEMBER)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Session {
  id                String    @id @default(cuid())
  userId            String
  refreshTokenHash  String    @unique // SHA-256 of the opaque refresh token; raw token never stored
  userAgent         String?
  ipAddress         String?
  /// Sliding (idle) expiry, pushed forward while the session is used.
  expiresAt         DateTime
  /// Hard limit: the session can never be extended past this date.
  absoluteExpiresAt DateTime?
  lastUsedAt        DateTime  @default(now())
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id             String        @id @default(cuid())
  actorId        String?
  organizationId String?
  action         String // e.g. "inventory.reserve"
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  requestId      String?
  createdAt      DateTime      @default(now())
  actor          User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
}

// ───────────────────────────────── Catalog ─────────────────────────────────

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  sortOrder   Int        @default(0)
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
}

model Product {
  id               String             @id @default(cuid())
  name             String
  slug             String             @unique
  description      String?
  categoryId       String
  status           ProductStatus      @default(DRAFT)
  minOrderQty      Int                @default(1)
  decorationMethod String? // sublimation, broderie, sérigraphie, tampographie…
  leadTimeDays     Int?
  unitLabel        String             @default("pièce") // shown as "par {unitLabel}"
  compareAtPrice   Decimal?           @db.Decimal(14, 2) // struck-through "was" price
  colors           String[]           @default([])
  sizes            String[]           @default([])
  placements       PrintPlacement[]   @default([])
  images           String[]           @default([]) // storefront-relative paths, e.g. /photos/tasse-11oz.jpg
  pricingMode      PricingMode        @default(PER_PIECE)
  supportsLogo     Boolean            @default(true)
  supportsText     Boolean            @default(true)
  supportsArtwork  Boolean            @default(false)
  artworkRequired  Boolean            @default(false)
  /// { minWidthCm, maxWidthCm, minHeightCm, maxHeightCm, defaultWidthCm, defaultHeightCm, minBillableM2 } or null
  customSize       Json?
  /// Option labels + whether the customer must choose (a selector only exists when `colors` / `sizes` is non-empty).
  colorLabel       String             @default("Couleur")
  sizeLabel        String             @default("Taille")
  colorsRequired   Boolean            @default(false)
  sizesRequired    Boolean            @default(false)
  customOrderItems CustomOrderItem[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  category         Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants         ProductVariant[]
  attributes       ProductAttribute[]

  @@index([categoryId, status])
}

enum PrintPlacement {
  FRONT
  BACK
  CHEST_LEFT
  SLEEVE
  WRAP
  FULL
  SIDE
  TOP
}

enum PricingMode {
  PER_PIECE
  PER_AREA // price tiers hold HTG per m²
}

enum UploadPurpose {
  LOGO
  ARTWORK
  /// Rendered mock-up (PNG/JPEG) of a print zone, uploaded by the storefront at checkout.
  PREVIEW
}

enum ElementKind {
  LOGO
  TEXT
  ARTWORK
}

model ProductAttribute {
  id        String                  @id @default(cuid())
  productId String
  name      String // e.g. "Couleur", "Taille"
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  product   Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  values    ProductAttributeValue[]

  @@unique([productId, name])
}

model ProductAttributeValue {
  id          String                  @id @default(cuid())
  attributeId String
  value       String
  attribute   ProductAttribute        @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variants    VariantAttributeValue[]

  @@unique([attributeId, value])
}

model ProductVariant {
  id              String                  @id @default(cuid())
  productId       String
  sku             String                  @unique
  name            String
  basePrice       Decimal                 @db.Decimal(14, 2)
  currency        String                  @default("HTG") @db.Char(3)
  weightGrams     Int?
  isActive        Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  product         Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValues VariantAttributeValue[]
  priceTiers      PriceTier[]
  inventoryItems  InventoryItem[]

  @@index([productId])
}

model VariantAttributeValue {
  variantId        String
  attributeValueId String
  variant          ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue   ProductAttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([variantId, attributeValueId])
}

model PriceTier {
  id        String         @id @default(cuid())
  variantId String
  minQty    Int
  unitPrice Decimal        @db.Decimal(14, 2)
  currency  String         @default("HTG") @db.Char(3)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, minQty])
}

// ─────────────────────────────── Warehousing ───────────────────────────────

model Warehouse {
  id        String              @id @default(cuid())
  code      String              @unique
  name      String
  address   String?
  city      String?
  country   String              @default("HT") @db.Char(2)
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  locations WarehouseLocation[]
}

model WarehouseLocation {
  id             String          @id @default(cuid())
  warehouseId    String
  code           String // e.g. "A-01-03"
  name           String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  inventoryItems InventoryItem[]

  @@unique([warehouseId, code])
}

// ──────────────────────────────── Inventory ────────────────────────────────

model InventoryItem {
  id           String                 @id @default(cuid())
  variantId    String
  locationId   String
  // Invariants (enforced in InventoryService + DB CHECK constraints in migration):
  //   onHand >= 0, reserved >= 0, damaged >= 0, inTransit >= 0
  //   reserved + damaged <= onHand   →   available = onHand - reserved - damaged >= 0
  onHand       Int                    @default(0)
  reserved     Int                    @default(0)
  damaged      Int                    @default(0)
  inTransit    Int                    @default(0)
  reorderPoint Int?
  version      Int                    @default(0)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  variant      ProductVariant         @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location     WarehouseLocation      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  movements    InventoryMovement[]
  reservations InventoryReservation[]

  @@unique([variantId, locationId])
  @@index([locationId])
}

enum InventoryMovementType {
  RECEIPT
  RESERVE
  RELEASE
  ISSUE
  ADJUSTMENT
  DAMAGE
  TRANSFER_OUT
  TRANSFER_IN
}

/// Immutable ledger. Rows are only ever inserted (UPDATE/DELETE blocked by DB trigger).
model InventoryMovement {
  id              String                @id @default(cuid())
  inventoryItemId String
  type            InventoryMovementType
  quantity        Int // signed delta applied to the affected bucket
  bucket          String // "onHand" | "reserved" | "damaged" | "inTransit"
  reference       String? // order id, PO id, reservation id…
  reason          String?
  actorId         String?
  createdAt       DateTime              @default(now())
  inventoryItem   InventoryItem         @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([inventoryItemId, createdAt])
  @@index([reference])
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
}

model InventoryReservation {
  id              String            @id @default(cuid())
  inventoryItemId String
  quantity        Int
  reference       String // order / program / cart reference
  status          ReservationStatus @default(ACTIVE)
  expiresAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  inventoryItem   InventoryItem     @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([inventoryItemId, status])
  @@index([reference])
}

// ───────────────────────────── Uploads (customer files) ─────────────────────────────

/// A customer-supplied file (logo artwork). Bytes live in object storage (S3/MinIO) or local disk.
model Upload {
  id            String                   @id @default(uuid()) @db.Uuid
  storageKey    String                   @unique // random, never derived from the client filename
  storageDriver String // "s3" | "local"
  originalName  String // sanitized, display only
  mimeType      String
  size          Int
  sha256        String                   @db.Char(64)
  width         Int?
  height        Int?
  purpose       UploadPurpose            @default(LOGO)
  createdAt     DateTime                 @default(now())
  orderItems    CustomOrderItem[]
  quoteRequests QuoteRequest[]
  elements      CustomOrderItemElement[]
  previews      CustomOrderItemPreview[]

  @@index([createdAt])
}

// ─────────────────────────── Custom orders (storefront) ───────────────────────────

enum CustomOrderStatus {
  RECEIVED
  MOCKUP_SENT
  APPROVED
  IN_PRODUCTION
  READY
  DELIVERED
  CANCELLED
}

enum DeliveryMethod {
  PICKUP
  DELIVERY
}

/// Order placed from the public storefront customizer. Prices are computed server-side and snapshotted.
model CustomOrder {
  id             String             @id @default(cuid())
  reference      String             @unique // IP-YYYY-NNNNNN, from sequence custom_order_ref_seq
  status         CustomOrderStatus  @default(RECEIVED)
  currency       String             @default("HTG") @db.Char(3)
  subtotal       Decimal            @db.Decimal(14, 2)
  customerName   String
  company        String?
  phone          String
  email          String // stored lower-cased
  city           String?
  address        String?
  deliveryMethod DeliveryMethod
  notes          String?
  ipAddress      String?
  /// Set when the order was placed (or later claimed) by a signed-in customer; null for guest orders.
  userId         String?
  user           User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Entry of the back-office customer directory (matched by e-mail), set when the order is created.
  customerId     String?
  customer       Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  items          CustomOrderItem[]
  events         CustomOrderEvent[]

  @@index([userId, createdAt])
  @@index([email])
  @@index([status, createdAt])
  @@index([customerId, createdAt])
}

/// Back-office customer directory. Created automatically from orders and account sign-ups (matched by lower-cased e-mail)
/// or by hand by staff; also used as the billing counterpart.
model Customer {
  id            String         @id @default(cuid())
  email         String         @unique // stored lower-cased
  fullName      String
  company       String?
  phone         String?
  address       String?
  city          String?
  country       String         @default("HT")
  taxId         String?
  notes         String?
  /// Link to the customer's web account, when they have one.
  userId        String?        @unique
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// 'ORDER' | 'ADMIN' | 'ACCOUNT'
  source        String         @default("ORDER")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  orders        CustomOrder[]
  quoteRequests QuoteRequest[]

  @@index([fullName])
  @@index([createdAt])
}

enum OrderEventType {
  STATUS
  NOTE
  DOCUMENT
  EMAIL
}

/// Timeline of an order (status changes, internal notes, documents, e-mails).
model CustomOrderEvent {
  id        String         @id @default(cuid())
  orderId   String
  type      OrderEventType
  message   String
  data      Json?
  actorId   String?
  createdAt DateTime       @default(now())
  order     CustomOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor     User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model CustomOrderItem {
  id          String                   @id @default(cuid())
  orderId     String
  lineNo      Int // 1-based position in the order, as submitted
  productId   String
  variantId   String?
  productSlug String // snapshot
  productName String // snapshot
  unitPrice   Decimal                  @db.Decimal(14, 2) // snapshot at order time
  quantity    Int
  lineTotal   Decimal                  @db.Decimal(14, 2)
  color       String?
  size        String?
  widthCm     Decimal?                 @db.Decimal(8, 1)
  heightCm    Decimal?                 @db.Decimal(8, 1)
  areaM2      Decimal?                 @db.Decimal(10, 4)
  /// Legacy single-logo columns, kept (nullable) and filled from the first element for old consumers.
  placement   PrintPlacement?
  uploadId    String?                  @db.Uuid
  notes       String?
  createdAt   DateTime                 @default(now())
  order       CustomOrder              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product                  @relation(fields: [productId], references: [id], onDelete: Restrict)
  upload      Upload?                  @relation(fields: [uploadId], references: [id], onDelete: Restrict)
  elements    CustomOrderItemElement[]
  previews    CustomOrderItemPreview[]

  @@unique([orderId, lineNo])
  @@index([productId])
  @@index([uploadId])
}

model CustomOrderItemElement {
  id         String          @id @default(cuid())
  itemId     String
  sort       Int
  placement  PrintPlacement
  kind       ElementKind
  uploadId   String?         @db.Uuid
  text       String?
  font       String?
  fontWeight String?
  color      String?
  align      String?
  x          Float
  y          Float
  scale      Float
  rotation   Float
  createdAt  DateTime        @default(now())
  item       CustomOrderItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  upload     Upload?         @relation(fields: [uploadId], references: [id], onDelete: Restrict)

  @@unique([itemId, sort])
  @@index([uploadId])
}

/// Rendered mock-up of one print zone of an order item (so staff see what the customer saw).
model CustomOrderItemPreview {
  id        String          @id @default(cuid())
  itemId    String
  placement PrintPlacement
  uploadId  String          @db.Uuid
  createdAt DateTime        @default(now())
  item      CustomOrderItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  upload    Upload          @relation(fields: [uploadId], references: [id], onDelete: Restrict)

  @@unique([itemId, placement])
  @@index([uploadId])
}

// ---------------------------------------------------------------------------------------------------------------------
// Billing: quotes, proformas, invoices, payments (see docs/admin-contract.md §3)
// ---------------------------------------------------------------------------------------------------------------------

enum DocumentType {
  QUOTE
  PROFORMA
  INVOICE
}

enum DocumentStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  MONCASH
  NATCASH
  BANK_TRANSFER
  ZELLE
  CARD
  CHECK
  OTHER
}

/// Singleton row (id = "singleton"): company identity, defaults and numbering prefixes used on every document.
model BillingSettings {
  id                  String   @id @default("singleton")
  legalName           String
  address             String
  city                String
  country             String
  phone               String
  email               String
  website             String?
  taxId               String?
  defaultCurrency     String   @default("HTG") @db.Char(3)
  defaultTaxRate      Decimal  @default(0) @db.Decimal(5, 2)
  paymentTermsDays    Int      @default(15)
  quoteValidityDays   Int      @default(30)
  prefixQuote         String   @default("DEV")
  prefixProforma      String   @default("PRO")
  prefixInvoice       String   @default("FAC")
  bankDetails         String?
  paymentInstructions String?
  defaultTerms        String?
  footerNote          String?
  logoUrl             String?
  updatedAt           DateTime @updatedAt
}

/// Gap-free yearly counters; the row is locked (`SELECT … FOR UPDATE`) while a number is allocated.
model DocumentCounter {
  type DocumentType
  year Int
  last Int          @default(0)

  @@id([type, year])
}

model Document {
  id                  String          @id @default(cuid())
  type                DocumentType
  number              String          @unique
  status              DocumentStatus  @default(DRAFT)
  currency            String          @db.Char(3)
  issueDate           DateTime        @db.Date
  dueDate             DateTime?       @db.Date
  validUntil          DateTime?       @db.Date
  /// Plain column (no relation): the Customer directory is owned by the admin core module.
  customerId          String?
  customerName        String
  customerCompany     String?
  customerEmail       String
  customerPhone       String?
  customerAddress     String?
  customerCity        String?
  customerCountry     String?
  customerTaxId       String?
  /// Plain column (no relation) to the custom order this document was prepared from.
  orderId             String?
  orderReference      String?
  parentId            String?
  parent              Document?       @relation("DocumentLineage", fields: [parentId], references: [id], onDelete: SetNull)
  children            Document[]      @relation("DocumentLineage")
  discountAmount      Decimal         @default(0) @db.Decimal(14, 2)
  shippingAmount      Decimal         @default(0) @db.Decimal(14, 2)
  taxRate             Decimal         @default(0) @db.Decimal(5, 2)
  subtotal            Decimal         @default(0) @db.Decimal(14, 2)
  taxTotal            Decimal         @default(0) @db.Decimal(14, 2)
  total               Decimal         @default(0) @db.Decimal(14, 2)
  amountPaid          Decimal         @default(0) @db.Decimal(14, 2)
  balance             Decimal         @default(0) @db.Decimal(14, 2)
  notes               String?
  internalNotes       String?
  terms               String?
  paymentInstructions String?
  sentAt              DateTime?
  sentTo              String[]
  acceptedAt          DateTime?
  acceptedIp          String?
  publicToken         String?         @unique
  voidedAt            DateTime?
  voidReason          String?
  createdById         String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  lines               DocumentLine[]
  payments            Payment[]
  events              DocumentEvent[]

  @@index([type, status])
  @@index([customerId])
  @@index([orderId])
  @@index([issueDate])
  @@index([createdAt])
}

model DocumentLine {
  id              String   @id @default(cuid())
  documentId      String
  position        Int
  description     String
  sku             String?
  productId       String?
  quantity        Decimal  @db.Decimal(12, 3)
  unit            String?
  unitPrice       Decimal  @db.Decimal(14, 2)
  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  lineTotal       Decimal  @db.Decimal(14, 2)
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, position])
}

model Payment {
  id           String        @id @default(cuid())
  documentId   String
  amount       Decimal       @db.Decimal(14, 2)
  currency     String        @db.Char(3)
  method       PaymentMethod
  paidAt       DateTime
  reference    String?
  notes        String?
  voidedAt     DateTime?
  voidReason   String?
  recordedById String?
  createdAt    DateTime      @default(now())
  document     Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([paidAt])
}

model DocumentEvent {
  id         String   @id @default(cuid())
  documentId String
  type       String // STATUS | SENT | PAYMENT | NOTE | CONVERTED | VIEWED | ACCEPTED
  message    String
  data       Json?
  actorId    String?
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
}

enum QuoteRequestService {
  ARTICLES
  SOURCING
  EVENT
  CONSULTING
}

enum QuoteRequestStatus {
  NEW
  IN_PROGRESS
  PROFORMA_SENT
  WON
  LOST
}

/// Request for a proforma sent from the storefront form (/devis): promotional items, sourcing, event or consulting.
/// Staff follow it up in the back-office and answer with a proforma (billing Document of type PROFORMA).
model QuoteRequest {
  id           String              @id @default(cuid())
  reference    String              @unique // DMD-YYYY-NNNNNN, from sequence quote_request_ref_seq
  service      QuoteRequestService
  /// 'petit' (< 100) | 'moyen' (100–1 000) | 'grand' (1 000 +); null when unknown.
  size         String?
  status       QuoteRequestStatus  @default(NEW)
  fullName     String
  company      String?
  phone        String
  email        String // stored lower-cased
  project      String
  quantity     Int?
  message      String?
  logoUploadId String?             @db.Uuid
  logoUpload   Upload?             @relation(fields: [logoUploadId], references: [id], onDelete: SetNull)
  customerId   String?
  customer     Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  internalNote String?
  ipAddress    String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([customerId])
  @@index([createdAt])
}
