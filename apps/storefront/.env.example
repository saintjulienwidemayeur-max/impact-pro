# Public site URL (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp number, international format without "+" (e.g. 509XXXXXXXX).
# When unset, WhatsApp CTAs link to /contact instead.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Optional social profile URLs — links are only rendered when set.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
